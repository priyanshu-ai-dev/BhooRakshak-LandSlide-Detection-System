# ╔══════════════════════════════════════════════════════════════════╗
# ║   NER Landslide EWS — Environment Variables Template            ║
# ║   Copy this file to .env and fill in your values.               ║
# ║   Never commit .env to version control.                          ║
# ╚══════════════════════════════════════════════════════════════════╝

# ─── PostgreSQL / PostGIS ─────────────────────────────────────────────────────
POSTGRES_DB=ner_landslide
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy connection URL (used by the backend)
DATABASE_URL=postgresql://postgres:changeme_in_production@localhost:5432/ner_landslide

# ─── Backend (FastAPI) ────────────────────────────────────────────────────────
BACKEND_PORT=8000
DEBUG=false

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# Leave empty when using Vite's dev-proxy (recommended for local dev).
# Set to the full backend URL when deploying separately, e.g.:
#   VITE_API_BASE_URL=https://api.your-domain.com
VITE_API_BASE_URL=
